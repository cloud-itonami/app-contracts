{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://etzhayyim.com/schema/contracts#",
    "schema": "https://schema.org/",
    "etzhayyim": "https://etzhayyim.com/schema/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "gleif": "https://www.gleif.org/ontology/",
    "Organization": {
      "@id": "schema:Organization",
      "@type": "@id"
    },
    "Person": {
      "@id": "schema:Person",
      "@type": "@id"
    },
    "Contract": {
      "@id": "etzhayyim:Contract",
      "@type": "@id"
    },
    "SocialContract": {
      "@id": "etzhayyim:SocialContract",
      "@type": "@id"
    },
    "LegalEntity": {
      "@id": "gleif:LegalEntity",
      "@type": "@id"
    },
    "name": "schema:name",
    "alternateName": "schema:alternateName",
    "description": "schema:description",
    "identifier": "schema:identifier",
    "url": "schema:url",
    "sameAs": {
      "@id": "schema:sameAs",
      "@type": "@id"
    },
    "legalName": "schema:legalName",
    "taxID": "schema:taxID",
    "vatID": "schema:vatID",
    "lei": {
      "@id": "gleif:hasLEI",
      "@type": "xsd:string"
    },
    "jurisdiction": "etzhayyim:jurisdiction",
    "foundingDate": {
      "@id": "schema:foundingDate",
      "@type": "xsd:date"
    },
    "dissolutionDate": {
      "@id": "schema:dissolutionDate",
      "@type": "xsd:date"
    },
    "givenName": "schema:givenName",
    "familyName": "schema:familyName",
    "birthDate": {
      "@id": "schema:birthDate",
      "@type": "xsd:date"
    },
    "nationality": "schema:nationality",
    "contractType": "etzhayyim:contractType",
    "parties": {
      "@id": "etzhayyim:parties",
      "@type": "@id",
      "@container": "@set"
    },
    "effectiveDate": {
      "@id": "etzhayyim:effectiveDate",
      "@type": "xsd:date"
    },
    "expirationDate": {
      "@id": "etzhayyim:expirationDate",
      "@type": "xsd:date"
    },
    "terminationDate": {
      "@id": "etzhayyim:terminationDate",
      "@type": "xsd:date"
    },
    "value": "schema:value",
    "currency": "schema:priceCurrency",
    "status": "etzhayyim:status",
    "documentUrl": {
      "@id": "etzhayyim:documentUrl",
      "@type": "@id"
    },
    "constitutionalType": "etzhayyim:constitutionalType",
    "adoptedDate": {
      "@id": "etzhayyim:adoptedDate",
      "@type": "xsd:date"
    },
    "signatories": {
      "@id": "etzhayyim:signatories",
      "@type": "@id",
      "@container": "@set"
    },
    "scope": "etzhayyim:scope",
    "source": "schema:source",
    "dateCollected": {
      "@id": "etzhayyim:dateCollected",
      "@type": "xsd:dateTime"
    },
    "lastVerified": {
      "@id": "etzhayyim:lastVerified",
      "@type": "xsd:dateTime"
    },
    "confidence": {
      "@id": "etzhayyim:confidence",
      "@type": "xsd:float"
    }
  }
}
